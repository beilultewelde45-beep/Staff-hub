# Copy to .env and fill in. Never commit .env.

# MongoDB Atlas connection string (database name in the path, e.g. /staffhub)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/staffhub?retryWrites=true&w=majority

# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me

NODE_ENV=development
PORT=3000

# Optional: bcrypt cost factor (default 12)
# BCRYPT_ROUNDS=12
