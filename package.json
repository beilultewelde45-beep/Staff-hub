{
  "name": "staffhub",
  "version": "0.1.0",
  "description": "StaffHub — web-based HR management system (recruitment → onboarding → attendance → leave → payroll → assets → offboarding).",
  "private": true,
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "dev:mem": "node scripts/dev-memory.js",
    "seed": "node seed/seed.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-flash": "^0.1.1",
    "connect-mongo": "^6.0.0",
    "csrf-sync": "^4.2.1",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.10",
    "ejs": "^7.0.2",
    "express": "^4.22.3",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^8.7.5",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "method-override": "^3.0.0",
    "mongoose": "^8.24.10"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.4.0",
    "supertest": "^7.3.2"
  }
}
